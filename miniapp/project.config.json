{
  "miniprogramRoot": "dist/",
  "projectname": "ptking-miniapp",
  "description": "PtKing 心理测试与塔罗微信小程序",
  "appid": "touristappid",
  "setting": {
    "urlCheck": false,
    "es6": false,
    "enhance": true,
    "compileHotReLoad": false,
    "postcss": false,
